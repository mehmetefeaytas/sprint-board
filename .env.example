# Sprint Panosu — ortam değişkenleri şablonu
#
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun:
#   cp .env.example .env.local
#
# Üretimde (Vercel) değerleri panelden ya da CLI ile ekleyin:
#   npx vercel env add SESSION_SECRET production --value "$DEGER"
# Değeri boru hattıyla (echo ... | vercel env add) vermeyin; boş kaydedilebiliyor.

# ── Zorunlu ──────────────────────────────────────────────────────────────────

# Neon Postgres bağlantı adresi.
# Vercel'de Neon entegrasyonunu bağlarsanız bu değişken otomatik enjekte edilir,
# elle eklemeniz gerekmez. Lokalde aşağıdaki "Lokal geliştirme" bloğuna bakın.
DATABASE_URL=

# JWT imza anahtarı. Oturum çerezi (sb_session) bununla imzalanır.
# Üretmek için:  openssl rand -base64 32
# Değiştirirseniz tüm mevcut oturumlar geçersiz olur.
SESSION_SECRET=

# Yönetici hesaplarının giriş şifresi.
# sprint.config.ts içinde is_admin: true olan kişilerden girişte bu şifre istenir;
# diğerleri yalnızca e-posta yazarak girer.
ADMIN_PASSWORD=

# POST /api/seed çağrısını korur. İstek "x-seed-token" başlığında bu değeri
# taşımak zorundadır. Uç nokta oturum gerektirmediği için tahmin edilebilir
# bir değer bırakmayın.
# Üretmek için:  openssl rand -hex 24
SEED_TOKEN=

# ── Yalnızca lokal geliştirme ────────────────────────────────────────────────

# Neon'un HTTP sürücüsü düz bir Postgres'e bağlanamaz; lokalde araya Neon
# protokolünü konuşan bir proxy gerekir (bkz. README → Lokal geliştirme).
# Tanımlıysa lib/db.ts sürücünün fetchEndpoint'ini bu adrese çevirir.
# ÜRETİMDE TANIMLAMAYIN.
# NEON_LOCAL_PROXY=http://localhost:4444/sql

# Docker'daki yerel Postgres için örnek DATABASE_URL:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/sprintboard
